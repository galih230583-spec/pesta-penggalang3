        }
      },
      "required": [
        "id",
        "nomorRegistrasi",
        "tanggalDaftar",
        "tanggalDihapus",
        "namaSekolah",
        "namaKepalaSekolah",
        "nipKepalaSekolah",
        "namaPembinaPutra",
        "nipPembinaPutra",
        "namaPembinaPutra2",
        "nipPembinaPutra2",
        "namaPembinaPutri",
        "nipPembinaPutri",
        "namaPembinaPutri2",
        "nipPembinaPutri2",
        "namaReguPutra",
        "namaReguPutri",
        "pesertaPutra",
        "tempatLahirPutra",
        "tanggalLahirPutra",
        "pesertaPutri",
