      ]
    }
  },
  "firestore": {
    "/registrations/{registrationId}": {
      "schema": {
        "$ref": "#/entities/Registration"
      },
      "description": "Centralized school registrations collection accessible across all school accounts and the committee admin panel."
    },
    "/deleted_registrations/{registrationId}": {
      "schema": {
        "$ref": "#/entities/DeletedRegistration"
      },
      "description": "Recycle bin / deletion history of school registrations in the Admin panel, allowing full restoration or permanent deletion."
    }
  }
}
